# ─────────────────────────────────────────────────────
# GrievAI Backend — Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── MongoDB (Atlas or local) ──────────────────────────
# Local:  mongodb://127.0.0.1:27017/grievai
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/grievai
MONGO_URI=mongodb://127.0.0.1:27017/grievai

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=grievai_super_secret_jwt_key_change_in_prod_2025
JWT_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────
# Local:   redis://127.0.0.1:6379
# Upstash: rediss://:password@host:port
REDIS_URL=redis://127.0.0.1:6379

# ── AI Microservice (FastAPI) ─────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── File Uploads ─────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Frontend URL (for CORS) ───────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Demo Mode ────────────────────────────────────────
# true  → auto-generates a complaint every 3 seconds (for demo/presentation)
# false → completely disabled
DEMO_MODE=false

# ── Default Admin credentials (seeded on first run) ──
ADMIN_EMAIL=admin@grievai.gov.in
ADMIN_PASSWORD=Admin@GrievAI2025
